#: ../initial_setup/common.py:140
msgid ""
"Are you sure you want to quit the configuration process?\n"
"You might end up with an unusable system if you do. Unless the License "
"agreement is accepted, the system will be rebooted."
msgstr ""
"D tidet tebɣiḍ ad teffɣeḍ seg ukala n twila?\n"
"Yezmer ad teggriḍ s unagraw ur yettwaseqdacen ara. Slid ma yella amtawi n "
"turagt yettwaqbal, anagraw ad yales tukkra."

#: ../initial_setup/common.py:144
msgid ""
"Are you sure you want to quit the configuration process?\n"
"You might end up with unusable system if you do."
msgstr ""
"D tidet tebɣiḍ ad teffɣeḍ seg ukala n twila?\n"
"Tzemreḍ ad d-teggriḍ s unagraw ur yettwaseqdacan ara."

